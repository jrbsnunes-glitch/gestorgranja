# Copie para /var/www/gestorgranja/.env e preencha os segredos.
# cp deploy/env.production.example .env && nano .env

NODE_ENV=production

# API NestJS
PORT=3010

# Portas Docker (localhost only)
PORTA_POSTGRES=5440
PORTA_REDIS=6382
DB_USER=gestorgranja
DB_PASS=GERAR_openssl_rand_hex_16

# URLs Prisma (ajuste DB_PASS e portas se necessário)
CENTRAL_DATABASE_URL=postgresql://gestorgranja:SUBSTITUA_SENHA@localhost:5440/gestorgranja_central
TENANT_DATABASE_URL=postgresql://gestorgranja:SUBSTITUA_SENHA@localhost:5440/gestorgranja_tenant_template
TENANT_ADMIN_DATABASE_URL=postgresql://gestorgranja:SUBSTITUA_SENHA@localhost:5440/postgres

REDIS_URL=redis://localhost:6382

JWT_SECRET=GERAR_openssl_rand_hex_32
JWT_EXPIRES=8h
JWT_REFRESH_SECRET=GERAR_openssl_rand_hex_32_OUTRO
JWT_REFRESH_EXPIRES=7d

# Next.js (build + runtime)
NEXT_PUBLIC_API_URL=/api
API_UPSTREAM=http://127.0.0.1:3010

# Primeiro tenant (script pnpm --filter @gestor-granja/api seed:initial)
INITIAL_TENANT_SLUG=demo
INITIAL_TENANT_CNPJ=00000000000191
INITIAL_COMPANY_NAME=Granja Demo
INITIAL_ADMIN_EMAIL=admin@gestorgranja.com
INITIAL_ADMIN_PASSWORD=DEFINIR_SENHA_FORTE
