CENTRAL_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/gestorgranja_central
TENANT_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/gestorgranja_tenant_template
TENANT_ADMIN_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/postgres
REDIS_URL=redis://localhost:6382
JWT_SECRET=change-me-dev-secret-min-32-chars-long
JWT_EXPIRES=8h
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES=7d
PORT=3010
# /api = proxy pelo Next (recomendado para Tailscale). Ou URL completa da API.
NEXT_PUBLIC_API_URL=/api
# Destino do proxy (só no servidor Next)
API_UPSTREAM=http://127.0.0.1:3010
FISCAL_CERT_ENCRYPTION_KEY=
# CAs extras (Linux/VPS): caminho para .pem ICP-Brasil
# FISCAL_TLS_EXTRA_CA=
# Somente dev com proxy/antivírus inspecionando HTTPS (nunca em produção):
# FISCAL_SEFAZ_TLS_INSECURE=1
# Responsável técnico (NT 2018.005 / infRespTec) — CNPJ do desenvolvedor do software
# FISCAL_RESP_TEC_CNPJ=
# FISCAL_RESP_TEC_CONTACT=
# FISCAL_RESP_TEC_EMAIL=
# FISCAL_RESP_TEC_PHONE=
# CSRT (SEFAZ AM homolog/prod — quando exigido): id 2 dígitos + código secreto
# FISCAL_RESP_TEC_CSRT_ID=
# FISCAL_RESP_TEC_CSRT=
# Reforma tributária (IBS/CBS — NT 2025.002). Homolog CRT 3 exige grupo IBSCBS (rejeição 1115).
# FISCAL_RTC_IBSCBS_ALWAYS=1
# FISCAL_RTC_P_IBS_UF=0.1
# FISCAL_RTC_P_IBS_MUN=0
# FISCAL_RTC_P_CBS=0.9
