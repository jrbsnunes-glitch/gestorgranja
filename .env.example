CENTRAL_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/gestorgranja_central
TENANT_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/gestorgranja_tenant_template
TENANT_ADMIN_DATABASE_URL=postgresql://gestorgranja:gestorgranja@localhost:5440/postgres
REDIS_URL=redis://localhost:6382
JWT_SECRET=change-me-dev-secret-min-32-chars-long
