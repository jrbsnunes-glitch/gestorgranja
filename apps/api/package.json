{
  "name": "@gestor-granja/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/sync-generated-to-dist.cjs",
    "dev": "node scripts/sync-generated-to-dist.cjs && nest start --watch",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema=prisma/central/schema.prisma && dotenv -e ../../.env -- prisma generate --schema=prisma/tenant/schema.prisma",
    "prisma:migrate:central": "dotenv -e ../../.env -- prisma migrate deploy --schema=prisma/central/schema.prisma",
    "prisma:migrate:tenant": "dotenv -e ../../.env -- prisma migrate deploy --schema=prisma/tenant/schema.prisma",
    "prisma:migrate:tenant:dev": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "tenant:provision": "tsx scripts/provision-tenant.ts",
    "tenant:license": "tsx scripts/tenant-license.ts",
    "tenant:license-show": "tsx scripts/tenant-license.ts show",
    "tenant:license-activate": "tsx scripts/tenant-license.ts activate",
    "tenant:license-extend": "tsx scripts/tenant-license.ts extend",
    "tenant:migrate-all": "dotenv -e ../../.env -- tsx scripts/migrate-all-tenants.ts",
    "seed:demo": "tsx scripts/seed-demo-tenant.ts",
    "seed:initial": "dotenv -e ../../.env -- tsx scripts/seed-initial-tenant.ts",
    "seed:egg-stock:demo": "tsx scripts/seed-egg-stock-demo.ts",
    "seed:chart-accounts:all": "tsx scripts/seed-chart-accounts-all-tenants.ts",
    "permissions:upsert-all": "dotenv -e ../../.env -- tsx scripts/upsert-permissions.ts",
    "postinstall": "pnpm prisma:generate"
  },
  "dependencies": {
    "@gestor-granja/types": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.1.0",
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
