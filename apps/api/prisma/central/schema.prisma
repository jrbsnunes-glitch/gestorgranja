generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/central-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL_DATABASE_URL")
}

enum LicenseStatus {
  trial
  active
  suspended
  expired
}

enum TenantProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
}

enum TenantFeatureCode {
  PUBLIC_BIDDING
  IOT_ENVIRONMENT
  FLEET
}

enum CommercialPlan {
  basic
  complete
}

model Tenant {
  id                    String                   @id @default(uuid())
  slug                  String                   @unique
  cnpj                  String                   @unique
  companyName           String
  licenseStatus         LicenseStatus            @default(trial)
  licenseExpiresAt      DateTime?
  commercialPlan        CommercialPlan           @default(basic)
  contractEntryFeeBrl   Int                      @default(0)
  contractMonthlyFeeBrl Int                      @default(0)
  maxBirds              Int                      @default(2147483647)
  maxBarns              Int                      @default(2147483647)
  maxUsers              Int                      @default(2147483647)
  contractStartedAt     DateTime?
  billingDay            Int                      @default(10)
  databaseName          String                   @unique
  provisioningStatus    TenantProvisioningStatus @default(PENDING)
  provisioningError     String?
  provisioningUpdatedAt DateTime?
  provisionAdminEmail   String?
  archivedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  features              TenantFeature[]
}

model TenantFeature {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      TenantFeatureCode
  enabledAt DateTime          @default(now())

  @@unique([tenantId, code])
}
